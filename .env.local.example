# Point this at your backend API base (see the load-shedding-api project).
# Local dev:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Vercel-deployed backend:
# NEXT_PUBLIC_API_BASE_URL=https://load-shedding-api.vercel.app/api/v1

# Google OAuth (Sign in with Google) — must be the SAME client ID as the
# backend's GOOGLE_CLIENT_ID. Get it from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs. Add both
# http://localhost:3000 and your deployed frontend URL under
# "Authorized JavaScript origins" for that client ID, or the button will
# fail with "origin not allowed" errors.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
